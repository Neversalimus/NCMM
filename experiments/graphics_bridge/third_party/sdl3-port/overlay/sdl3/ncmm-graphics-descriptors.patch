+/* LOCAL DIAGNOSTIC ONLY. Fixed bounded storage, no per-call file I/O.
+ * Nested CPU wall scopes are not GPU execution measurements. */
+typedef struct {
+    Uint64 begin, end, thread;
+    const char *name;
+} NCMMRecordProbeEvent;
+#define NCMM_RECORD_PROBE_CAPACITY 262144
+static NCMMRecordProbeEvent ncmm_record_probe_events[NCMM_RECORD_PROBE_CAPACITY];
+static SDL_AtomicInt ncmm_record_probe_count;
+static void NCMMRecordProbe(const char *name, Uint64 begin, bool always)
+{
+    const Uint64 end = SDL_GetPerformanceCounter();
+    if (always || end - begin >= SDL_GetPerformanceFrequency() / 10000) {
+        const int index = SDL_AddAtomicInt(&ncmm_record_probe_count, 1);
+        if (index >= 0 && index < NCMM_RECORD_PROBE_CAPACITY) {
+            NCMMRecordProbeEvent *event = &ncmm_record_probe_events[index];
+            event->begin = begin; event->end = end;
+            event->thread = (Uint64)SDL_GetCurrentThreadID(); event->name = name;
+        }
+    }
+}
+
+/* Destroy may run for several Native GPU devices. Keep every completed segment. */
+static int ncmm_record_probe_dumped;
+static SDL_SpinLock ncmm_record_probe_dump_lock;
+static void NCMMRecordProbeDump(void)
+{
+    SDL_LockSpinlock(&ncmm_record_probe_dump_lock);
+    SDL_IOStream *file = SDL_IOFromFile("ncmm-sdl-record-probe.tsv", "ab");
+    if (!file) { SDL_UnlockSpinlock(&ncmm_record_probe_dump_lock); return; }
+    const int total = SDL_GetAtomicInt(&ncmm_record_probe_count);
+    const int end = total < NCMM_RECORD_PROBE_CAPACITY ? total : NCMM_RECORD_PROBE_CAPACITY;
+    SDL_IOprintf(file, "# Native diagnostic, CPU wall only; frequency=%llu; total=%d; capacity=%d; start=%d; end=%d\n",
+        (unsigned long long)SDL_GetPerformanceFrequency(), total, NCMM_RECORD_PROBE_CAPACITY,
+        ncmm_record_probe_dumped, end);
+    SDL_IOprintf(file, "index\tname\tthread\tbegin\tend\n");
+    for (int i = ncmm_record_probe_dumped; i < end; ++i) {
+        const NCMMRecordProbeEvent *event = &ncmm_record_probe_events[i];
+        if (event->name) {
+            SDL_IOprintf(file, "%d\t%s\t%llu\t%llu\t%llu\n", i, event->name,
+                (unsigned long long)event->thread,
+                (unsigned long long)event->begin, (unsigned long long)event->end);
+        }
+    }
+    ncmm_record_probe_dumped = end;
+    SDL_CloseIO(file);
+    SDL_UnlockSpinlock(&ncmm_record_probe_dump_lock);
+}
