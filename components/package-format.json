{
  "schema": 1,
  "format": "ncmm-component-package-v1",
  "required_fields": [
    "id",
    "version",
    "kind",
    "atomic_group",
    "dependencies",
    "payload",
    "sha256"
  ],
  "allowed_payload_strategies": [
    "source_build",
    "binary_replace",
    "tooling_replace",
    "external_package"
  ],
  "migration_hooks": {
    "pre_install": "optional PowerShell script",
    "post_install": "optional PowerShell script",
    "state_migrations": "ordered explicit schema migrations only"
  },
  "security": {
    "transport": "HTTPS for remote feeds",
    "integrity": "SHA-256 package + inner package.integrity.json",
    "automatic_apply": "certified releases only by default"
  },
  "note": "Infrastructure 0.8.3.1 uses a staged transaction shell: offline verification is the install gate; runtime module verification is deferred until the first normal Host launch. Host 0.8.0 / Survivor 0.11.3 / AWS 0.6.2 are the native runtime stack in this candidate."
}
