# Source/package digest identity must not depend on the runner's core.autocrlf.
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.dll binary
experiments/graphics_bridge/third_party/sdl3-port/** -text
# Preserve the author's licensed OBJ/MTL bytes and their archive hashes.
experiments/FirstPersonView/assets/vehicles/source/** -text whitespace=-blank-at-eol,-blank-at-eof
# The frozen Native PLF oracle retains upstream indentation and its exact digest.
experiments/FirstPersonView/tests/third_party/native_plf_list.h whitespace=-space-before-tab

# Keep derived measurement tables collapsed in code review; reports remain readable.
experiments/FirstPersonView/qualification/0.13.0-psx-*-ablation.json linguist-generated=true
experiments/FirstPersonView/qualification/0.13.0-psx-short-controls.json linguist-generated=true
experiments/FirstPersonView/qualification/0.13.0-psx-cell-controls.json linguist-generated=true
